rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "krishindolia2@gmail.com" && isVerified();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Asset Validation
    function isValidAsset(data) {
      return data.keys().hasAll(['userId', 'name', 'paisaVasoolIndex', 'finalDecision', 'vettedAt']) 
             && data.userId is string 
             && data.name is string && data.name.size() <= 200
             && data.paisaVasoolIndex is number
             && data.finalDecision is string
             && data.vettedAt is timestamp
             && data.userId == request.auth.uid;
    }

    // Waitlist Validation
    function isValidWaitlistEntry(data) {
      return data.keys().hasAll(['email', 'rank', 'timestamp', 'verified'])
             && data.email is string && data.email.size() <= 100
             && data.rank is number
             && data.timestamp is timestamp
             && data.verified is bool;
    }

    match /assets/{assetId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
                    && isValidId(assetId) 
                    && isValidAsset(incoming())
                    && incoming().vettedAt == request.time;
      
      allow delete: if isSignedIn() && isOwner(existing().userId);

      allow update: if isSignedIn() 
                    && isOwner(existing().userId)
                    && (incoming().lastPriceCheck == request.time || (incoming().keys().hasAny(['lastPriceCheck']) == false || incoming().lastPriceCheck == existing().lastPriceCheck))
                    && incoming().diff(existing()).affectedKeys().hasOnly(['currentPrice', 'lastPriceCheck', 'priceAlertActive', 'targetPrice', 'lifecycleStatus']);
    }

    match /feed/{feedId} {
      allow read: if true; // Publicly viewable for trust and global transparency
      allow create: if isSignedIn()
                    && isValidId(feedId)
                    && (incoming().keys().hasAll(['userId', 'productName', 'paisaVasoolIndex', 'verdict', 'timestamp', 'socialHook']))
                    && incoming().userId == request.auth.uid
                    && incoming().timestamp == request.time;
      
      allow update: if isSignedIn()
                    && incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
                    && incoming().likes == (existing().get('likes', 0) + 1);
      
      allow delete: if false;
    }

    match /trends/{trendId} {
      allow read: if true;
      allow write: if false; // System defined
    }

    match /status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /waitlist/{entryId} {
      allow get: if isAdmin() || (isValidId(entryId)); // Allow anyone to check existence/rank by ID safely (PII is minimal)
      allow list: if isAdmin();
      allow create: if (isValidId(entryId) && isValidWaitlistEntry(incoming()) && incoming().timestamp == request.time) || isAdmin();
    }

    match /audit_feedback/{feedbackId} {
      allow read: if true;
      allow list: if isAdmin();
      allow create: if isValidId(feedbackId) 
                    && incoming().keys().hasAll(['recId', 'accuracyScore', 'timestamp'])
                    && incoming().accuracyScore >= 1 && incoming().accuracyScore <= 5
                    && incoming().timestamp == request.time;
    }

    match /hotline/{messageId} {
      allow read, list: if isAdmin();
      allow create: if isValidId(messageId)
                    && (incoming().keys().hasAll(['email', 'message', 'timestamp']))
                    && incoming().email is string && incoming().email.size() <= 100
                    && incoming().message is string && incoming().message.size() <= 1000
                    && incoming().timestamp == request.time;
    }

    match /analytics_v1/{logId} {
      allow read, list: if isAdmin();
      allow create: if true;
    }
  }
}
